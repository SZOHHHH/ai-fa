---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import katex from 'katex';
const B = import.meta.env.BASE_URL;

const docs = await getCollection('docs');

// ── 真实统计 ──
const byType = { paper: 0, formula: 0, concept: 0, algo: 0, matrix: 0 };
for (const d of docs) {
  const head = d.id.split('/')[0];
  if (head === '10-Papers') byType.paper++;
  else if (head === '30-Formulas') byType.formula++;
  else if (head === '40-Concepts') byType.concept++;
  else if (head === '20-Algorithms') byType.algo++;
  else if (head === '60-Matrices') byType.matrix++;
}

// ── 研究线（真实目录结构）──
const lineMap = new Map();
for (const d of docs) {
  const m = d.id.match(/^10-Papers\/([^/]+)\//);
  if (m) lineMap.set(m[1], (lineMap.get(m[1]) || 0) + 1);
}
const lines = [...lineMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));
// 目录名 → 中文线名（目录本身无中文的补齐）
const LINE_ZH = { '05-MoE': 'MoE 混合专家' };
const lineName = (l) => LINE_ZH[l] || l.replace(/^\d+-/, '');

// ── 精读层精选（真实 frontmatter）──
const picks = docs
  .filter(d => /精读/.test(d.data.layer || '') && d.id.startsWith('10-Papers/'))
  .slice(0, 3);
const oneLiner = (d) => {
  const m = (d.body || '').match(/## 1\.\s*[^\n]*\n+([^\n]+)/);
  return m ? m[1].replace(/[*$`\[\]]/g, '').slice(0, 110) : (d.data.matrix_coords || '');
};

// ── 签名 hero 公式（库内真家伙：DDPM 训练目标）──
const heroTex = katex.renderToString(
  String.raw`L_{\text{简单}}=\mathbb{E}_{x_0,\epsilon,t}\Big[\big\lVert \epsilon-\epsilon_\theta\big(\sqrt{\bar\alpha_t}\,x_0+\sqrt{1-\bar\alpha_t}\,\epsilon,\ t\big)\big\rVert^2\Big]`,
  { displayMode: true, throwOnError: false, strict: false }
);
---
<Base>
  <section class="hero wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 class="display">{byType.paper} 篇论文，<br/>从数学根基讲起。</h1>
        <p class="lede">每一篇都拆到公式、概念与中文直觉——不看二手解读，回到推导本身。十条研究线织成一张知识网络，互相引用，彼此照明。</p>
        <div class="cta">
          <a class="btn primary" href={B + "atlas"}>进入知识图谱</a>
          <a class="btn" href={B + "lines"}>按研究线浏览</a>
        </div>
      </div>
      <figure class="hero-eq">
        <div class="eq" set:html={heroTex} />
        <figcaption class="anno">直觉：给干净画面撒一片雪花，再让网络学会认出"哪片雪花盖在哪"——世界模型与蒸馏共用的地基。</figcaption>
      </figure>
    </div>
  </section>

  <section class="stats wrap" aria-label="库统计">
    <div><b>{byType.paper}</b><span>论文卡</span></div>
    <div><b>{byType.formula}</b><span>公式实体</span></div>
    <div><b>{byType.concept}</b><span>概念</span></div>
    <div><b>{byType.algo}</b><span>算法</span></div>
    <div><b>{byType.matrix}</b><span>机会格矩阵</span></div>
  </section>

  <section id="lines" class="wrap lines">
    <h2 class="display sec">研究线 <a class="all" href={B + "lines"}>全部 →</a></h2>
    <div class="line-grid">
      {lines.map(([l, n]) => (
        <a class="line" href={`${B}explore/10-Papers/${l}`}>
          <span class="no">{l.split('-')[0]}</span>
          <span class="name">{lineName(l)}</span>
          <span class="n">{n} 篇</span>
        </a>
      ))}
    </div>
  </section>

  <section id="picks" class="wrap picks">
    <h2 class="display sec">近期精读 <a class="all" href={B + "picks"}>全部 →</a></h2>
    <div class="pick-grid">
      {picks.map(d => (
        <a class="pick" href={`${B}explore/${d.id}`}>
          <span class="k" data-t="paper">论文</span>
          <h3 class="display">{d.data.title}</h3>
          <p>{oneLiner(d)}</p>
          <span class="meta">{d.data.venue || d.data.line || ''}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { padding: 88px 24px 52px; }
  .hero-grid { display: grid; grid-template-columns: 3fr 1fr; gap: 60px; align-items: center; }
  .hero-copy h1 { font-size: clamp(28px, 5vw, 60px); line-height: 1.16; letter-spacing: 1px; margin: 0 0 24px; }
  .lede { font-family: var(--font-fs); font-size: 24px; color: var(--ink-2); max-width: 30em; margin: 0 0 34px; }
  .cta { display: flex; gap: 16px; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 13px 32px; border: 1px solid var(--hairline); border-radius: 999px;
    font-family: var(--font-display); font-size: 24px; font-weight: 600; color: var(--ink); background: var(--panel); transition: all .18s; }
  .btn:hover { text-decoration: none; border-color: var(--ink-blue); color: var(--ink-blue); }
  .btn.primary { background: var(--ink-blue); border-color: var(--ink-blue); color: #fff; }
  .btn.primary:hover { background: #0d3668; }
  .hero-eq { margin: 0; padding: 30px 28px 24px; background: var(--panel); border: 1px solid var(--hairline);
    border-radius: var(--radius); box-shadow: var(--shadow); }
  .hero-eq .eq { font-size: 0.92em; overflow-x: auto; }
  .hero-eq figcaption { margin-top: 18px; border-top: 1px dashed var(--hairline); padding-top: 15px; }
  .stats { display: flex; gap: 14px; padding: 38px 24px 12px; flex-wrap: wrap; }
  .stats div { flex: 1 1 140px; background: var(--panel); border: 1px solid var(--hairline); border-radius: var(--radius);
    padding: 22px 25px; display: flex; flex-direction: column; }
  .stats b { font-family: var(--font-display); font-size: 44px; font-weight: 900; line-height: 1.05; }
  .stats span { font-size: 20px; color: var(--muted); margin-top: 4px; }
  .sec { font-size: 32px; margin: 60px 0 24px; }
  .all { font-size: 20px; font-family: var(--font-body); font-weight: 400; color: var(--muted); margin-left: 12px; }
  .all:hover { color: var(--ink-blue); }
  .line-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 12px; }
  .line { display: flex; align-items: baseline; gap: 14px; padding: 18px 22px; background: var(--panel);
    border: 1px solid var(--hairline); border-radius: 8px; color: var(--ink); transition: border-color .15s; }
  .line:hover { text-decoration: none; border-color: var(--ink-blue); }
  .line .no { font-family: var(--font-mono); font-size: 20px; color: var(--ink-blue); }
  .line .name { font-family: var(--font-display); font-weight: 700; font-size: 28px; }
  .line .n { margin-left: auto; font-size: 20px; color: var(--muted); }
  .pick-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .pick { display: flex; flex-direction: column; gap: 12px; padding: 26px; background: var(--panel);
    border: 1px solid var(--hairline); border-radius: var(--radius); color: var(--ink); transition: border-color .15s, box-shadow .15s; }
  .pick:hover { text-decoration: none; border-color: var(--ink-blue); box-shadow: var(--shadow); }
  .pick .k { font-size: 20px; letter-spacing: 3px; color: var(--t-paper); font-weight: 700; }
  .pick h3 { font-size: 24px; margin: 0; line-height: 1.45; }
  .pick p { font-family: var(--font-fs); font-size: 20px; color: var(--ink-2); margin: 0; flex: 1; }
  .pick .meta { font-size: 20px; color: var(--muted); }
  @media (max-width: 1100px) { .hero-grid { grid-template-columns: 1fr; } .pick-grid { grid-template-columns: 1fr; } }
</style>
